# Python / backend
backend/__pycache__/
backend/**/__pycache__/
backend/.venv/
backend/.pdm-python
backend/.mypy_cache/
backend/.pytest_cache/
*.pyc

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Env files (never commit real secrets)
.env
backend/.env
frontend/.env
!*.env.example
# frontend/.env.production is intentionally NOT ignored — it holds only
# VITE_API_BASE_URL, a public URL (not a secret), baked in at Vite build
# time. Its absence previously caused every local build to silently embed
# "undefined" as the API base URL, breaking the deployed site.

# OS
.DS_Store

# Editors
.vscode/
.idea/

# Wrangler local cache (account info, etc.)
.wrangler/
